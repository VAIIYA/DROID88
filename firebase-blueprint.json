{
  "entities": {
    "users": {
      "title": "Users and Developer Profiles",
      "description": "Stores user authentication profiles, developer account names, studio info, and tester tiers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "developerAccountName": { "type": "string", "description": "Public Studio or Developer Account Name" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["developer", "tester"] },
        "testerTier": { "type": "string", "enum": ["tier_1_standard", "tier_2_verified", "tier_3_core"] },
        "bio": { "type": "string" },
        "website": { "type": "string" },
        "contactEmail": { "type": "string" },
        "googlePlayConsoleDevId": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "apps": {
      "title": "Apps and Closed Testing Tracks",
      "description": "Android applications submitted for 14-day 20-tester closed testing tracks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "packageName": { "type": "string" },
        "developerId": { "type": "string" },
        "developerName": { "type": "string" },
        "testingTrackUrl": { "type": "string" },
        "targetTesters": { "type": "number" },
        "currentTesters": { "type": "number" }
      }
    }
  }
}
