rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User and Developer Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /developerProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Apps and Closed Testing Tracks
    match /apps/{appId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Bug Reports & Screenshots
    match /bugReports/{bugId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Automated Feedback Milestones
    match /automatedFeedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Feature Feedback & Comments
    match /featureFeedbacks/{feedbackId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
